{
    "name": "student/schedule",
    "description": "Расписание занятий: Course, Teacher, ScheduleService (автозагрузка PSR-4)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "University\\Schedule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "University\\Schedule\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@php -l public/index.php",
            "@php tests/run.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
